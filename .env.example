# ==============================================================================
# ShopSmart AI — Environment Variables Template
# Copy this file to `.env.local` and add your confidential API keys.
# NEVER commit `.env.local` or sensitive keys to Git/GitHub.
# ==============================================================================

# 1. AI & LLM Providers (Server-side Only)
GEMINI_API_KEY=your_gemini_api_key_here
PIXELAPI_KEY=your_pixelapi_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# 2. Upstash Redis (Caching & Rate Limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# 3. Clerk Authentication (Public Key + Server Secret Key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# 4. Supabase (Optional Database / Telemetry)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
